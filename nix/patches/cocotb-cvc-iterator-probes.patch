@@ -21,6 +21,17 @@
 
 // TODO Move the check_vpi_error stuff into another file
 
+static inline bool is_cvc_simulator() {
+    static const bool is_cvc = []() {
+        s_vpi_vlog_info info;
+        if (!vpi_get_vlog_info(&info) || info.product == nullptr) {
+            return false;
+        }
+        return std::strstr(info.product, "CVC") != nullptr;
+    }();
+    return is_cvc;
+}
+
 // Should be run after every VPI call to check error status
 static inline void __check_vpi_error(const char *file, const char *func,
                                      long line) {
@@ -256,6 +267,12 @@ class VpiPackageIterator : public GpiIterator {
         : GpiIterator(impl, nullptr)
 
     {
+        // CVC does not support vpiInstance. It records an otherwise handled
+        // capability probe as a process error, so do not probe for packages.
+        if (is_cvc_simulator()) {
+            return;
+        }
+
         // Questa doesn't support iteration over vpiPackage but everything
         // supports vpiInstance which is a superset
         m_iterator = vpi_iterate(vpiInstance, nullptr);
