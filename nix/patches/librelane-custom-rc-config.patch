From: Zamlet project
Subject: Allow PDKs to provide a custom OpenROAD RC setup script

Some PDK integrations provide aggregate signal and clock RC values that cannot
be represented by LibreLane's layer-based RC variables. Allow those PDKs to
provide a script containing the OpenROAD set_layer_rc and set_wire_rc commands.

diff --git a/librelane/steps/openroad.py b/librelane/steps/openroad.py
index eac226b..4380aef 100644
--- a/librelane/steps/openroad.py
+++ b/librelane/steps/openroad.py
@@ -218,6 +218,12 @@ class OpenROADStep(TclStep):
             default=False,
         ),
         Variable(
+            "SET_RC_TCL",
+            Optional[Path],
+            "A custom PDK script containing set_layer_rc and set_wire_rc commands.",
+            pdk=True,
+        ),
+        Variable(
             "LAYERS_RC",
             Optional[Dict[str, Dict[str, Dict[str, Decimal]]]],
             "Used during PNR steps, Specific custom resistance and capacitance values for metal layers."
diff --git a/librelane/scripts/openroad/common/set_rc.tcl b/librelane/scripts/openroad/common/set_rc.tcl
index 8c5b6ae..b0e6e12 100644
--- a/librelane/scripts/openroad/common/set_rc.tcl
+++ b/librelane/scripts/openroad/common/set_rc.tcl
@@ -23,6 +23,11 @@ proc log_cmd_rc {cmd args} {
     }
 }
 
+if { [info exists ::env(SET_RC_TCL)] } {
+    source $::env(SET_RC_TCL)
+    return
+}
+
 proc set_layers_custom_rc {args} {
     # Returns: All corner names for which RC values were found
     set i "0"
